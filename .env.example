# ==========================================
# កំណត់ព័ត៌មានសម្ងាត់ API Keys / Tokens
# ==========================================

# 1. Telegram Settings
# បង្កើត Bot តាម @BotFather ដើម្បីយក Token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Channel Username (@my_channel) ឬ ID (-100xxxxxxxxx)
TELEGRAM_CHANNEL_ID=your_telegram_channel_id_here
# Group ID (-100xxxxxxxxx ឬ -xxxxxxxxx)
TELEGRAM_GROUP_ID=your_telegram_group_id_here

# 2. Facebook Page Settings
# យកពី Facebook Page About / Settings
FB_PAGE_ID=your_facebook_page_id_here
# Page Access Token (Long-lived Token) យកពី Graph API Explorer
FB_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here

# 3. TikTok Developer Settings
# Access Token ពី TikTok Developer Portal (Content Posting API)
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token_here
